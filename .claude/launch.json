{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "portfolio-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "portfolio-ollama",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "OLLAMA_URL=http://localhost:11434",
        "OLLAMA_MODEL=qwen2.5:7b-instruct",
        "ASK_IP_LIMIT=10000",
        "LLM_TIMEOUT_MS=45000",
        "npx",
        "next",
        "start",
        "-p",
        "3006"
      ],
      "port": 3006
    },
    {
      "name": "portfolio-eval",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ASK_IP_LIMIT=10000",
        "npx",
        "next",
        "start",
        "-p",
        "3007"
      ],
      "port": 3007
    }
  ]
}